{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/secrets/**)",
      "Read(/config/credentials.json)",
      "Edit(/reference/**)",
      "Bash(git push *--force*)",
      "PowerShell(git push *--force*)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)"
    ]
  }
}
